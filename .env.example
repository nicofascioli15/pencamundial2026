# ── Vercel KV (Redis) ──────────────────────────────────────────────
# Estas variables las obtenés automáticamente al crear un KV store en Vercel
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Seguridad ──────────────────────────────────────────────────────
# Generá un string aleatorio largo (ej: openssl rand -base64 32)
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio

# ── Superadmin ────────────────────────────────────────────────────
# Tu usuario y contraseña de administrador
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia_esto_por_tu_clave_segura

# ── Código de invitación ──────────────────────────────────────────
# Los empleados necesitan este código para registrarse
INVITE_CODE=MUNDIAL2026
